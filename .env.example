# ==============================================================================
# Environment Configuration Template - Campus Complaint & Resolution System
# Copy this file to .env for local overrides (DO NOT commit .env to Git)
# ==============================================================================

# Django Security
DEBUG=True
SECRET_KEY=django-insecure-campus-complaint-system-dev-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Cloud Deployment Specific (Render)
PORT=8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cloud Database (Supabase PostgreSQL)
# Example URI: postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# Cloud Storage (Supabase Storage - Private Bucket)
# Use the server-side 'service_role' secret key for backend private storage operations
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-secret-key
# SUPABASE_BUCKET=complaint-attachments
# SUPABASE_STORAGE_IS_PUBLIC=False
# SUPABASE_SIGNED_URL_EXPIRY=3600
